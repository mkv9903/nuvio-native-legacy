nuvio-proto
nuvio-proto.arm
*.ipk
local.properties
deploy/app/nuvio-proto
deploy/app/art/cache/
# catalogo-rede.bin is EXECUTION CACHE for the catalog from addons — the
# app itself discards it when build changes ("[cat] discarded cache").
deploy/app/art/catalogo-rede.bin

# SECRETS of the owner. DO NOT version: these are account keys, not configuration.
# tmdb.txt and trakt.txt WERE ALREADY tracked and were removed from index with
# `git rm --cached`; older history still contains them (commit 4ea949d onward).
# Repository is local, without remote — if it ever gets a remote, rotate keys first.
deploy/app/art/tmdb.txt
deploy/app/art/trakt.txt
deploy/app/art/mdblist.txt
# addons.txt was left out of previous cleanup and WAS STILL TRACKED. The URL
# of each addon carries the debrid key in its path (see addons.h),
# so it is as secret as the above. Removed from index with
# `git rm --cached`; the file remains on disk and the app uses it while
# there is no account.
deploy/app/art/addons.txt
# settings.txt is the LAYOUT preference of the builder. Not a credential,
# but would arrive as if it were the installer's — now it comes from account.
deploy/app/art/ajustes.txt
deploy/app/art/settings.txt
deploy/app/art/collections.json
deploy/app/art/collections/

# Post draft: promotional material, not part of project.
POST-REDDIT.md
.claude/

